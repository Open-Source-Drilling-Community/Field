@page "/StatisticsField"
@inject ILogger<StatisticsField> logger
@inject ISnackbar Snackbar
@inject IFieldAPIUtils Api

@if (statistics_ == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudText Class="mt-4 mb-4" Typo="Typo.h5"><strong>Usage Statistics</strong></MudText>

    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.subtitle2">Total count</MudText>
            <MudText Typo="Typo.h6">@totalCount_</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.subtitle2">Tracked endpoints</MudText>
            <MudText Typo="Typo.h6">@rows_.Count</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.subtitle2">Last saved</MudText>
            <MudText Typo="Typo.h6">@FormatDate(statistics_.LastSaved)</MudText>
        </MudItem>
    </MudGrid>

    <MudTable Items="rows_" Dense="true" Hover="true" Bordered="true" SortLabel="Sort by">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Endpoint)">Endpoint</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Area)">Area</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.Total)">Total</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.LastUsed ?? DateTimeOffset.MinValue)">Last used</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Endpoint">@context.Endpoint</MudTd>
            <MudTd DataLabel="Area">@context.Area</MudTd>
            <MudTd DataLabel="Total">@context.Total</MudTd>
            <MudTd DataLabel="Last used">@FormatDate(context.LastUsed)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No usage counters were returned by the Field service.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private UsageStatisticsField? statistics_;
    private readonly List<UsageRow> rows_ = [];
    private long totalCount_;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statistics_ = await Api.ClientField.GetFieldUsageStatisticsAsync();
            BuildRows();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem UsageStatistics initialization");
            Snackbar.Add("Unable to load Field usage statistics.", Severity.Error);
        }
    }

    private void BuildRows()
    {
        rows_.Clear();
        totalCount_ = 0;

        if (statistics_ == null)
        {
            return;
        }

        foreach (var property in typeof(UsageStatisticsField).GetProperties()
                     .Where(property => property.PropertyType == typeof(History) && property.Name.EndsWith("PerDay", StringComparison.Ordinal))
                     .OrderBy(property => property.Name, StringComparer.Ordinal))
        {
            if (property.GetValue(statistics_) is not History history)
            {
                continue;
            }

            long total = history.Data?.Sum(entry => entry?.Count ?? 0) ?? 0;
            DateTimeOffset? lastUsed = history.Data?
                .Where(entry => entry != null && entry.Count > 0)
                .Select(entry => (DateTimeOffset?)entry.Date)
                .OrderByDescending(date => date)
                .FirstOrDefault();

            totalCount_ += total;
            string endpoint = CleanEndpointName(property.Name);
            rows_.Add(new UsageRow(endpoint, GuessArea(endpoint), total, lastUsed));
        }
    }

    private static string CleanEndpointName(string propertyName)
    {
        string value = propertyName.EndsWith("PerDay", StringComparison.Ordinal)
            ? propertyName[..^"PerDay".Length]
            : propertyName;

        return string.Concat(value.Select((ch, index) =>
            index > 0 && char.IsUpper(ch) && !char.IsUpper(value[index - 1])
                ? " " + ch
                : ch.ToString()));
    }

    private static string GuessArea(string endpoint)
    {
        if (endpoint.Contains("Delineation Line Type", StringComparison.OrdinalIgnoreCase))
        {
            return "Delineation line types";
        }
        if (endpoint.Contains("Feature Category", StringComparison.OrdinalIgnoreCase))
        {
            return "Field features";
        }
        if (endpoint.Contains("Identity", StringComparison.OrdinalIgnoreCase))
        {
            return "Field identities";
        }
        if (endpoint.Contains("Membership Category", StringComparison.OrdinalIgnoreCase))
        {
            return "Field memberships";
        }
        if (endpoint.Contains("Usage Statistics", StringComparison.OrdinalIgnoreCase))
        {
            return "Monitoring";
        }

        return "Fields";
    }

    private static string FormatDate(DateTimeOffset? value) =>
        value.HasValue && value.Value != default
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "-";

    private sealed record UsageRow(string Endpoint, string Area, long Total, DateTimeOffset? LastUsed);
}
